{
  "name": "@p5-wrapper/next",
  "description": "A NextJS specific library for the @P5-Wrapper/react project.",
  "version": "3.0.1",
  "type": "module",
  "homepage": "https://github.com/P5-wrapper/next",
  "license": "MIT",
  "types": "dist/main.d.ts",
  "files": [
    "dist"
  ],
  "main": "./dist/next.umd.cjs",
